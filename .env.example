# Naero Mobile Environment Variables
# Copy this file to .env and fill in your values

# Backend API URL (e.g., http://localhost:3000 or production URL)
EXPO_PUBLIC_NAERO_API_URL=

# Supabase project URL (found in Supabase dashboard → Settings → API)
EXPO_PUBLIC_SUPABASE_URL=

# Supabase anon/public key (NOT the service_role key — this is safe for client-side use)
EXPO_PUBLIC_SUPABASE_ANON_KEY=
