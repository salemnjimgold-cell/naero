{
  "name": "naero-app",
  "version": "1.2.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "npx expo lint",
    "test:backend": "node tests/qa_backend_foundation.js",
    "test:ai": "node tests/qa_ai.js",
    "test:location": "node tests/location_foundation.js",
    "test:gateway": "node tests/backend_gateway.js && node tests/mobile_api_client.js",
    "test:nearby": "node tests/nearby_provider.js",
    "test:nearby:cities": "node tests/nearby_city_qa.js",
    "test:postgis": "node tests/postgis_verified_services.js",
    "test:security:notifications": "node tests/milestone5b_notifications.js",
    "test:security:sync": "node tests/milestone5b_sync.js",
    "test:security:auth": "node tests/milestone5b_auth_storage.js",
    "test:security:android": "node tests/milestone5b_android_security.js",
    "test:design:foundations": "node tests/milestone5c_3a_foundations.js && node tests/milestone5c_3a_contrast.js",
    "typecheck:location": "tsc -p jsconfig.location.json",
    "typecheck:nearby": "tsc -p jsconfig.nearby.json",
    "backend:dev": "powershell -ExecutionPolicy Bypass -File scripts/backend-dev.ps1",
    "backend:health": "powershell -ExecutionPolicy Bypass -File scripts/backend-health.ps1",
    "backend:smoke": "powershell -ExecutionPolicy Bypass -File scripts/backend-smoke.ps1",
    "postinstall": "node scripts/patch-expo-asset.js"
  },
  "dependencies": {
    "@expo/ngrok": "^4.1.3",
    "@expo/vector-icons": "^15.0.3",
    "@google/generative-ai": "^0.24.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "@supabase/supabase-js": "^2.108.2",
    "expo": "~54.0.0",
    "expo-asset": "~12.0.13",
    "expo-auth-session": "~7.0.11",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.11",
    "i18next": "^23.7.0",
    "jose": "^6.2.3",
    "playwright": "^1.61.1",
    "react": "19.1.0",
    "react-i18next": "^13.5.0",
    "react-native": "0.81.5",
    "react-native-fbsdk-next": "^13.4.3",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-toast-message": "^2.2.0",
    "react-native-worklets": "0.5.1",
    "sharp": "^0.35.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-private-methods": "^7.18.6",
    "babel-preset-expo": "~54.0.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~10.0.0",
    "patch-package": "^8.0.1"
  }
}
