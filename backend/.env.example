NODE_ENV=development
NAERO_SERVICE_ENV=development
PORT=8787
PUBLIC_BASE_URL=http://localhost:8787
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=60
PROVIDER_TIMEOUT_MS=8000
NEARBY_CACHE_TTL_MS=300000
NEARBY_CACHE_STALE_MS=1800000
VERIFIED_SERVICES_CACHE_TTL_MS=21600000

# Optional location/data providers. Empty values disable the provider safely.
GEOAPIFY_API_KEY=
GOOGLE_PLACES_API_KEY=
GOOGLE_MAPS_API_KEY=
NOMINATIM_BASE_URL=
OVERPASS_API_URL=

# Supabase project settings. Never commit real values.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Optional monitoring webhook. Leave empty for local development.
MONITORING_WEBHOOK_URL=
MONITORING_SAMPLE_RATE=1
