GEOAPIFY_API_KEY=
DISCOVERED_PLACE_STORE_ENABLED=false
DISCOVERED_PLACE_PERSISTENCE_ENABLED=false
DISCOVERY_COVERAGE_INTELLIGENCE_ENABLED=false
DISCOVERY_DEMAND_REFRESH_ENABLED=false
