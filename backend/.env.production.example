NODE_ENV=production
NAERO_SERVICE_ENV=production
PORT=8787
PUBLIC_BASE_URL=https://api.naero.app
CORS_ORIGINS=https://naero.app

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

MONITORING_WEBHOOK_URL=
